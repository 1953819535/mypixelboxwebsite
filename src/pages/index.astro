---
import axios from "axios";

// ----------------------------------------------------------------------
// 1. 工具函数
// ----------------------------------------------------------------------
function getImg(path: string, w: number = 0, q: number = 80) {
  if (!path) return "";
  if (path.startsWith("http")) return path;
  const cleanPath = path.replace(/^\//, "");
  const imageUrl = import.meta.env.IMAGE_URL;
  if (!imageUrl) return "";
  if (!w) return `${imageUrl}/${cleanPath}`;
  return `${imageUrl}/cdn-cgi/image/width=${w},quality=${q},format=auto/${cleanPath}`;
}

// ----------------------------------------------------------------------
// 2. 数据获取与类型
// ----------------------------------------------------------------------
interface Photo {
  _id: string;
  albumId: string;
  fileID: string;
  description: string;
  order: number;
  width: number;
  height: number;
  isFeatured: boolean;
}

interface Album {
  id: string;
  photos: Photo[];
  name: string;
  description: string;
  coverPhotoUrl: string;
  order: number;
}

async function fetchAlbums(): Promise<Album[]> {
  try {
    const API_BASE_URL = import.meta.env.API_BASE_URL;
    if (!API_BASE_URL) return [];
    const response = await axios.get(
      `${API_BASE_URL}/api/albums/gallery/public`
    );
    if (response.data.code !== 0) throw new Error(response.data.message);

    return response.data.data.map((album: any) => ({
      ...album,
      photos: album.photos || [],
    }));
  } catch (err: any) {
    console.error("Data Fetch Error:", err.message);
    return [];
  }
}

const albums: Album[] = await fetchAlbums();
const pageTitle = "WANDER | Some Portfolio";
const isTestMode = import.meta.env.TEST_MODE === "true";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{pageTitle}</title>
    {isTestMode && <meta name="test-mode" content="enabled" />}
    
    <!-- 字体：Playfair Display (艺术标题) + Anonymous Pro (打字机/便签感) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    
    <!-- 1. 桌面背景层 (Tabletop Atmosphere) -->
    <div class="tabletop-layer">
        <!-- 纹理噪点 -->
        <div class="noise-texture"></div>
        <!-- 暖色光斑 (模拟烛光或壁炉反光) -->
        <div class="warm-glow glow-1"></div>
        <div class="warm-glow glow-2"></div>
    </div>

    <!-- 2. 极简导航 -->
    <button id="menu-btn" class="nav-stamp">
        <span class="stamp-circle">MENU</span>
    </button>

    <!-- 菜单 -->
    <div id="menu-overlay" class="menu-overlay">
        <div class="menu-paper">
            <h2 class="menu-title">Collection Index</h2>
            <ul class="menu-list">
                {albums.map((album, index) => (
                    <li>
                        <button data-goto={`album-header-${index}`} class="menu-link">
                            <span class="m-idx">No.0{index+1}</span>
                            <span class="m-name">{album.name}</span>
                        </button>
                    </li>
                ))}
            </ul>
            <button id="close-menu">FOLD</button>
        </div>
    </div>

    <!-- 3. 散落流主容器 -->
    <main class="scatter-container">
        
        <!-- Intro Card: 像一张放在桌上的邀请函 -->
        <div class="scatter-item intro-item">
            <div class="paper-card intro-card">
                <div class="stamp-mark">WINTER LOG</div>
                <h1 class="intro-title">Scattered<br>Memories</h1>
                <p class="intro-text">
                    A collection of daily fragments,<br>
                    left on the table of time.
                </p>
                <div class="intro-sign">Est. 2025</div>
            </div>
        </div>

        {
          albums.map((album, index) => (
            <div class="album-group">
                
                <!-- Album Title: 像一个章节的分隔页 -->
                <div id={`album-header-${index}`} class="scatter-item album-header-item">
                    <div class="album-divider-text">
                        <span class="seq-no">COLLECTION 0{index + 1}</span>
                        <h2 class="album-name">{album.name}</h2>
                        <div class="red-line"></div>
                        <p class="album-desc">{album.description}</p>
                    </div>
                </div>

                <!-- Photos: 散落的照片 -->
                {album.photos.map((photo, pIndex) => {
                  // 这里的逻辑全靠 CSS nth-child 处理，HTML 结构保持一致
                  return (
                    <div class="scatter-item photo-item">
                        
                        <!-- 实体照片 (The Physical Photo) -->
                        <div class="photo-card">
                            <div class="photo-inner">
                                <img 
                                    src={getImg(photo.fileID, 1600)} 
                                    loading="lazy" 
                                    alt="Daily Record"
                                />
                            </div>
                            <!-- 胶带装饰 -->
                            <div class="tape-strip"></div>
                        </div>

                        <!-- 便签说明 (The Sticky Note) -->
                        <div class="note-card">
                            <div class="note-meta">
                                <span>DEC 25</span>
                                <span>#{pIndex + 1}</span>
                            </div>
                            {photo.description ? (
                                <p class="note-text">{photo.description}</p>
                            ) : (
                                <p class="note-text empty">Untitled.</p>
                            )}
                            <div class="note-tech">
                                {photo.width} × {photo.height}
                            </div>
                        </div>

                    </div>
                  );
                })}
            </div>
          ))
        }

        <!-- Footer: 最后的卡片 -->
        <div class="scatter-item footer-item">
            <div class="paper-card footer-card">
                <p class="merry-text">Merry Christmas</p>
                <p class="sub-text">& Happy New Year</p>
                <div class="divider-small"></div>
                <a href="https://beian.miit.gov.cn/" target="_blank">浙ICP备2025208482号-2</a>
            </div>
        </div>

    </main>

    <script>
        const menuBtn = document.getElementById("menu-btn");
        const overlay = document.getElementById("menu-overlay");
        const closeBtn = document.getElementById("close-menu");
        const links = document.querySelectorAll(".menu-link");

        function toggleMenu() {
            overlay.classList.toggle("active");
        }

        menuBtn.addEventListener("click", toggleMenu);
        closeBtn.addEventListener("click", toggleMenu);

        links.forEach(link => {
            link.addEventListener("click", (e) => {
                const targetId = e.currentTarget.dataset.goto;
                const targetEl = document.getElementById(targetId);
                if(targetEl){
                    toggleMenu();
                    // 稍微偏移一点，留出呼吸感
                    const y = targetEl.getBoundingClientRect().top + window.scrollY - 100;
                    window.scrollTo({top: y, behavior: 'smooth'});
                }
            })
        });
    </script>

    <style>
      :root {
        /* ----- 调色板：冬日桌面 ----- */
        --bg-table: #0f1c18;    /* 深天鹅绒绿 */
        --paper-white: #f2f0e9; /* 暖调相纸白 */
        --note-yellow: #fffdf5; /* 便签纸 */
        --ink-black: #222222;
        --ink-red: #a83232;     /* 像印泥一样的红 */
        --shadow-deep: rgba(0,0,0,0.4);
        
        --font-serif: 'Playfair Display', serif;
        --font-type: 'Anonymous Pro', monospace;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        background-color: var(--bg-table);
        color: var(--ink-black);
        font-family: var(--font-type);
        overflow-x: hidden;
      }

      /* --- 1. 桌面氛围 (Background) --- */
      .tabletop-layer { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
      .noise-texture {
        position: absolute; inset: 0; opacity: 0.06;
        background: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="n"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23n)"/%3E%3C/svg%3E');
      }
      .warm-glow {
        position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.3;
        animation: glowPulse 8s infinite alternate;
      }
      .glow-1 { width: 60vw; height: 60vw; background: #5e4b35; top: -20%; left: -10%; }
      .glow-2 { width: 50vw; height: 50vw; background: #2f4538; bottom: -10%; right: -10%; animation-delay: -4s; }
      @keyframes glowPulse { 0% { opacity: 0.2; transform: scale(1); } 100% { opacity: 0.4; transform: scale(1.1); } }

      /* --- 2. 导航 (Stamp Style) --- */
      .nav-stamp {
        position: fixed; top: 30px; right: 30px; z-index: 100;
        background: none; border: none; cursor: pointer;
        transition: transform 0.2s;
      }
      .nav-stamp:hover { transform: rotate(15deg); }
      .stamp-circle {
        display: flex; align-items: center; justify-content: center;
        width: 50px; height: 50px; border-radius: 50%;
        border: 2px dashed var(--paper-white);
        color: var(--paper-white); font-family: var(--font-type); font-size: 10px;
        backdrop-filter: blur(5px);
      }

      /* 菜单覆盖层 */
      .menu-overlay {
        position: fixed; inset: 0; z-index: 90;
        background: rgba(15, 28, 24, 0.95);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; pointer-events: none; transition: opacity 0.4s;
      }
      .menu-overlay.active { opacity: 1; pointer-events: auto; }
      
      .menu-paper {
        background: var(--paper-white); padding: 60px 40px;
        max-width: 400px; width: 90%;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        transform: rotate(-2deg); /* 菜单也是歪的 */
        text-align: center;
      }
      .menu-title { font-family: var(--font-serif); font-size: 2rem; margin-bottom: 30px; color: var(--ink-black); }
      .menu-list { list-style: none; margin-bottom: 40px; display: flex; flex-direction: column; gap: 15px; }
      .menu-link {
        background: none; border: none; cursor: pointer; display: block; width: 100%;
        font-family: var(--font-type); font-size: 1.2rem; color: #555; border-bottom: 1px dotted #ccc;
        padding: 5px 0; text-align: left; display: flex; justify-content: space-between;
      }
      .menu-link:hover { color: var(--ink-red); }
      .m-idx { font-size: 10px; opacity: 0.6; }
      #close-menu { background: var(--ink-black); color: #fff; border: none; padding: 10px 30px; cursor: pointer; font-family: var(--font-type); }

      /* --- 3. 散落布局核心 (Scatter Engine) --- */
      .scatter-container {
        padding: 100px 0 200px 0;
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center; /* 默认居中，后面用nth-child打破 */
        position: relative;
      }

      .scatter-item {
        margin-bottom: 80px; /* 基础垂直间距 */
        position: relative;
        width: fit-content;
        max-width: 90vw;
        transition: transform 0.3s;
      }
      
      /* --- 通用纸张/卡片样式 --- */
      .paper-card {
        background: var(--paper-white);
        padding: 40px;
        text-align: center;
        box-shadow: 0 10px 30px var(--shadow-deep);
      }
      
      /* Intro Card */
      .intro-item { margin-bottom: 150px; }
      .intro-card {
        width: 300px; height: 400px;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        transform: rotate(3deg);
      }
      .stamp-mark {
        border: 1px solid var(--ink-black); padding: 5px 10px; font-size: 10px;
        margin-bottom: 30px; letter-spacing: 0.2em;
      }
      .intro-title { font-family: var(--font-serif); font-size: 3rem; margin-bottom: 20px; line-height: 1; }
      .intro-text { font-size: 12px; line-height: 1.6; color: #666; font-style: italic; }
      .intro-sign { margin-top: 40px; font-family: var(--font-serif); color: var(--ink-red); }

      /* Album Header */
      .album-header-item {
        margin: 100px 0 50px 0;
        text-align: center;
        color: var(--paper-white); /* 只有标题文字直接写在桌面上 */
        z-index: 10;
      }
      .seq-no { font-size: 10px; letter-spacing: 0.3em; opacity: 0.7; display: block; margin-bottom: 10px; }
      .album-name { font-family: var(--font-serif); font-size: 4rem; margin-bottom: 10px; }
      .red-line { width: 50px; height: 2px; background: var(--ink-red); margin: 0 auto 20px; }
      .album-desc { font-size: 12px; opacity: 0.8; max-width: 400px; margin: 0 auto; line-height: 1.5; }

      /* --- Photo Item (照片+便签) --- */
      .photo-item {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        align-items: flex-start;
      }

      /* 实体照片卡 */
      .photo-card {
        background: #fff;
        padding: 15px 15px 40px 15px; /* 底部留白多一点，像拍立得 */
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        position: relative;
        z-index: 2;
        max-width: 100%;
      }
      .photo-inner img {
        display: block;
        max-width: 60vw; /* 限制最大宽度，防止撑破屏幕 */
        height: auto;    /* 高度自适应，保证完整显示 */
        max-height: 80vh; 
        object-fit: contain;
        filter: sepia(10%) contrast(1.05); /* 微弱的复古感 */
      }
      
      /* 胶带 */
      .tape-strip {
        position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
        width: 100px; height: 30px;
        background: rgba(255,255,255,0.2);
        backdrop-filter: blur(2px);
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        transform: rotate(-2deg);
      }

      /* 便签说明 */
      .note-card {
        background: var(--note-yellow);
        padding: 20px;
        width: 200px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        font-size: 12px;
        line-height: 1.4;
        position: relative;
        z-index: 3;
        color: #444;
      }
      .note-meta { border-bottom: 1px dashed #ccc; padding-bottom: 5px; margin-bottom: 10px; display: flex; justify-content: space-between; color: #999; font-size: 10px; }
      .note-text { margin-bottom: 15px; min-height: 40px; }
      .note-text.empty { opacity: 0.5; font-style: italic; }
      .note-tech { font-size: 9px; color: #aaa; text-align: right; }

      /* --- 核心随机散落逻辑 (CSS Chaos Engine) --- */
      
      /* 模式 1: 偏左，照片左歪，便签在右 */
      .photo-item:nth-child(3n+1) {
        margin-right: auto; margin-left: 5vw; /* 整体靠左 */
      }
      .photo-item:nth-child(3n+1) .photo-card {
        transform: rotate(-2deg);
      }
      .photo-item:nth-child(3n+1) .note-card {
        margin-top: 50px;
        transform: rotate(3deg);
      }

      /* 模式 2: 偏右，照片右歪，便签在左，稍微重叠 */
      .photo-item:nth-child(3n+2) {
        margin-left: auto; margin-right: 5vw; /* 整体靠右 */
        flex-direction: row-reverse; /* 便签在左边 */
      }
      .photo-item:nth-child(3n+2) .photo-card {
        transform: rotate(3deg);
      }
      .photo-item:nth-child(3n+2) .note-card {
        margin-top: 100px;
        margin-right: -30px; /* 压住照片一点 */
        transform: rotate(-4deg);
      }

      /* 模式 3: 居中，照片微歪，便签贴在下面 */
      .photo-item:nth-child(3n+3) {
        margin-left: auto; margin-right: auto;
        flex-direction: column; align-items: center;
      }
      .photo-item:nth-child(3n+3) .photo-card {
        transform: rotate(1deg);
      }
      .photo-item:nth-child(3n+3) .note-card {
        margin-top: -30px; /* 贴在照片下沿 */
        margin-left: 150px;
        transform: rotate(2deg);
        box-shadow: 0 10px 30px rgba(0,0,0,0.3); /* 浮起感更强 */
      }

      /* --- Footer --- */
      .footer-item { margin-top: 150px; }
      .footer-card {
        transform: rotate(-1deg);
        border: 4px double var(--ink-red); /* 节日感 */
      }
      .merry-text { font-family: var(--font-serif); font-size: 2rem; color: var(--ink-red); }
      .sub-text { font-size: 1rem; color: #666; margin-bottom: 20px; }
      .divider-small { width: 20px; height: 2px; background: #ccc; margin: 0 auto 20px; }
      .footer-card a { color: #999; text-decoration: none; font-size: 10px; }

      /* --- 移动端适配 --- */
      @media (max-width: 768px) {
        .photo-inner img { max-width: 85vw; }
        
        /* 移动端减弱左右偏移，防止溢出 */
        .photo-item:nth-child(n) {
          margin-left: auto; margin-right: auto;
          justify-content: center;
        }
        
        /* 移动端便签统一放在下面 */
        .photo-item:nth-child(3n+2) { flex-direction: row; flex-wrap: wrap; justify-content: center; }
        
        .note-card {
            width: 80%;
            margin: -20px auto 0 auto !important; /* 统一贴在下方 */
        }
        
        .album-name { font-size: 2.5rem; }
      }

    </style>
  </body>
</html>
