// ==========================================
// 1. 服务端数据处理 (Server-Side Logic)
// ==========================================
import axios from 'axios';

// 环境变量配置
const API_BASE_URL = import.meta.env.API_BASE_URL;
const IMAGE_URL = import.meta.env.IMAGE_URL;

/**
 * 图片地址处理工具
 * @param {string} path - 图片路径/ID
 * @param {number} w - 宽度 (0 为原图)
 * @param {number} q - 质量 (默认 90)
 */
function getImg(path, w = 0, q = 90) {
  if (!path) return "";
  if (path.startsWith("http")) return path;
  if (!IMAGE_URL) return path;
  
  const clean = path.replace(/^\//, "");
  if (!w) return `${IMAGE_URL}/${clean}`;
  return `${IMAGE_URL}/cdn-cgi/image/width=${w},quality=${q},format=auto/${clean}`;
}

/**
 * 格式化日期工具: YYYY.MM.DD
 */
function formatDate(isoString) {
  if (!isoString) return "";
  const date = new Date(isoString);
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
}

/**
 * 获取相册数据
 */
async function fetchGallery() {
  try {
    if (!API_BASE_URL) return [];
    const res = await axios.get(`${API_BASE_URL}/api/albums/gallery/public`);
    if (res.data.code !== 0) return [];

    return res.data.data.map((album, idx) => ({
      id: album.id,
      title: album.name,
      desc: album.description || "Collection of visual moments.",
      createTime: formatDate(album.createTime),
      coverFull: getImg(album.coverPhotoUrl, 1200),
      coverThumb: getImg(album.coverPhotoUrl, 800),
      photos: (album.photos || []).map(p => ({
        thumb: getImg(p.fileID, 800), 
        full: getImg(p.fileID, 1200),
        title: p.title || "Untitled", 
      })),
      index: idx
    }));
  } catch (e) {
    console.error("Fetch Gallery Error:", e);
    return [];
  }
}

// 执行数据获取
const gallery = await fetchGallery();
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>MYPIXELBOX | The Anthology</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    /* ==========================================
       2. CSS 样式系统
       ========================================== */
    :root {
      --bg: #0a0a0a;
      --text-main: #e0e0e0;
      --text-muted: #666;
      --font-serif: 'Cormorant Garamond', serif;
      --font-sans: 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    html { scroll-behavior: smooth; }
    
    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: var(--font-sans);
      overflow-x: hidden;
      /* 噪点背景图 */
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    }

    /* --- Top Navigation --- */
    .nav-bar {
      position: fixed; top: 0; left: 0; width: 100%; height: 80px;
      padding: 0 40px;
      display: flex; justify-content: space-between; align-items: center;
      z-index: 500;
      background: linear-gradient(to bottom, rgba(10,10,10,0.95), rgba(10,10,10,0));
      pointer-events: none;
    }
    .brand {
      pointer-events: auto;
      font-family: var(--font-serif); font-size: 22px; font-weight: 600; letter-spacing: 1px; color: #fff;
    }
    .menu-btn {
      pointer-events: auto; cursor: pointer;
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 8px 18px; border-radius: 20px;
      background: rgba(0,0,0,0.4); backdrop-filter: blur(10px);
      transition: 0.3s; color: #ccc;
    }
    .menu-btn:hover { background: #fff; color: #000; }

    /* --- Index Overlay (Menu) --- */
    .index-overlay {
      position: fixed; inset: 0; z-index: 800;
      background: rgba(5,5,5,0.98);
      display: flex; flex-direction: column; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
    }
    .index-overlay.active { opacity: 1; pointer-events: auto; }
    .index-list {
      list-style: none; padding: 0 40px;
      max-height: 80vh; overflow-y: auto;
      max-width: 800px; margin: 0 auto; width: 100%;
    }
    .index-item {
      border-bottom: 1px solid #222; padding: 25px 0; cursor: pointer;
      display: flex; justify-content: space-between; align-items: baseline;
      transition: 0.3s; color: #888;
    }
    .index-item:hover { color: #fff; padding-left: 10px; border-color: #444; }
    .index-item h3 { font-family: var(--font-serif); font-size: 1.8rem; font-weight: 300; margin-bottom: 5px; }
    .index-meta { font-family: monospace; font-size: 12px; letter-spacing: 1px; color: #555; }
    .index-close {
      position: absolute; top: 30px; right: 40px;
      font-size: 30px; cursor: pointer; color: #fff; padding: 10px;
    }

    /* --- Main Content --- */
    main { padding-top: 100px; }
    .chapter {
      margin-bottom: 140px;
      opacity: 0; transform: translateY(40px);
      transition: 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .chapter.visible { opacity: 1; transform: translateY(0); }

    .chapter-header {
      padding: 0 60px 30px;
      display: grid; grid-template-columns: 1fr auto; gap: 40px;
      border-bottom: 1px solid #1a1a1a; margin-bottom: 30px;
    }
    .ch-title h2 { font-family: var(--font-serif); font-size: 3rem; font-weight: 300; color: #eee; }
    .ch-meta { font-size: 11px; letter-spacing: 2px; color: #555; text-transform: uppercase; margin-top: 10px; font-family: monospace;}
    .ch-desc { font-family: var(--font-serif); font-size: 1.1rem; color: #888; font-style: italic; max-width: 400px; text-align: right;}

    /* --- Horizontal Stream --- */
    .stream {
      display: flex; gap: 40px;
      padding: 0 60px 40px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .stream::-webkit-scrollbar { display: none; }

    .card {
      flex: 0 0 auto; scroll-snap-align: center;
      display: flex; flex-direction: column; gap: 12px;
    }
    .card.is-cover { margin-right: 40px; position: relative; }
    .card.is-cover::after {
      content: ""; position: absolute; right: -30px; top: 10%; height: 80%;
      border-right: 1px solid #222;
    }
    .cover-badge {
      position: absolute; top: 12px; left: 12px;
      background: #fff; color: #000;
      font-size: 9px; font-weight: 700; padding: 3px 6px;
      letter-spacing: 1px; z-index: 10; pointer-events: none;
    }

    .card-img-box {
      height: 50vh; overflow: hidden; background: #111; cursor: zoom-in;
      transition: filter 0.3s;
    }
    .card-img-box img {
      height: 100%; width: auto; display: block;
      transition: transform 0.6s ease;
      filter: brightness(0.9);
    }
    .card:hover .card-img-box img { transform: scale(1.02); filter: brightness(1); }
    
    .caption {
      font-size: 10px; color: #555; letter-spacing: 1px;
      max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      text-transform: uppercase;
    }

    /* --- Lightbox --- */
    .lightbox {
      position: fixed; inset: 0; z-index: 999;
      background: #000;
      display: none; opacity: 0; transition: opacity 0.3s ease;
      flex-direction: column; justify-content: center;
    }
    .lightbox.active { display: flex; opacity: 1; }

    .lb-stage {
      flex: 1; display: flex; align-items: center; justify-content: center;
      position: relative; width: 100%; overflow: hidden;
    }
    .lb-img {
      max-width: 100%; max-height: 100%;
      object-fit: contain;
      opacity: 0; transform: scale(0.98);
      transition: opacity 0.4s ease, transform 0.4s ease;
      user-select: none;
    }
    .lb-img.show { opacity: 1; transform: scale(1); }

    .lb-top-bar {
      position: absolute; top: 0; left: 0; width: 100%; height: 60px;
      display: flex; justify-content: flex-end; align-items: center;
      padding: 0 20px; z-index: 1001;
      background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
    }
    .lb-close {
      color: #fff; font-size: 32px; cursor: pointer;
      width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;
      text-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }
    
    .lb-bottom-bar {
      position: absolute; bottom: 0; left: 0; width: 100%; height: 60px;
      display: flex; justify-content: center; align-items: center;
      z-index: 1001; pointer-events: none;
    }
    .lb-counter {
      color: #aaa; font-size: 12px; font-family: monospace; letter-spacing: 2px;
      background: rgba(0,0,0,0.5); padding: 5px 12px; border-radius: 12px;
      backdrop-filter: blur(4px);
    }

    .lb-nav-zone {
      position: absolute; top: 10%; bottom: 10%; width: 25%;
      z-index: 1000; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
    }
    .lb-prev-zone { left: 0; }
    .lb-next-zone { right: 0; }
    
    .lb-arrow {
      color: #fff; font-size: 40px; opacity: 0; transition: opacity 0.3s;
      text-shadow: 0 2px 10px rgba(0,0,0,0.8);
    }
    @media (min-width: 769px) {
      .lb-nav-zone:hover .lb-arrow { opacity: 1; }
    }
    
    .spinner {
      position: absolute; border: 2px solid rgba(255,255,255,0.1);
      border-top: 2px solid #fff; border-radius: 50%;
      width: 30px; height: 30px; animation: spin 0.8s linear infinite;
      display: none;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* --- Footer & Beian --- */
    footer {
      width: 100%;
      padding: 80px 20px 40px;
      background: linear-gradient(to top, #050505, transparent);
      display: flex; justify-content: center;
      border-top: 1px solid rgba(255, 255, 255, 0.03);
    }
    .footer-content {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; font-family: var(--font-sans);
    }
    .copyright {
      font-size: 12px; color: #444; letter-spacing: 0.5px; margin-bottom: 4px;
    }
    .beian-group {
      display: flex; align-items: center; gap: 15px;
      flex-wrap: wrap; justify-content: center;
    }
    .beian-item {
      display: flex; align-items: center;
      text-decoration: none; font-size: 11px;
      color: #555; transition: color 0.3s ease; letter-spacing: 0.5px;
    }
    .beian-item:hover { color: #aaa; }
    .police-icon {
      width: 14px; height: 14px; margin-right: 5px;
      opacity: 0.6; transition: opacity 0.3s ease;
    }
    .beian-item:hover .police-icon { opacity: 1; }
    .separator { color: #333; font-size: 10px; display: inline-block; }

    /* --- Mobile Responsive --- */
    @media (max-width: 768px) {
      .nav-bar { padding: 0 20px; }
      .index-list { padding: 0 20px; }
      .chapter-header { padding: 0 20px 20px; grid-template-columns: 1fr; gap: 10px; text-align: left; }
      .ch-desc { text-align: left; max-width: 100%; font-size: 1rem; }
      .stream { padding: 0 20px 20px; gap: 15px; }
      .card.is-cover { margin-right: 15px; }
      .card.is-cover::after { display: none; }
      .card-img-box { height: 55vh; max-width: 88vw; }
      .card-img-box img { width: 100%; height: 100%; object-fit: cover; }
      .ch-title h2 { font-size: 2.2rem; }
      
      /* Footer Mobile */
      footer { padding-bottom: 60px; }
      .footer-content { gap: 15px; }
      .beian-group { flex-direction: column; gap: 8px; }
      .separator { display: none; }
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav class="nav-bar">
    <div class="brand">MYPIXELBOX</div>
    <div class="menu-btn" onclick="toggleMenu()">Index</div>
  </nav>

  <!-- Overlay Menu -->
  <div id="index-overlay" class="index-overlay">
    <div class="index-close" onclick="toggleMenu()">×</div>
    <ul class="index-list">
      {gallery.map((album, idx) => (
        <li class="index-item" onclick={`scrollToAlbum(${idx})`}>
          <h3>{album.title}</h3>
          <div class="index-meta">{album.createTime} · {album.photos.length} Frames</div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Main Feed -->
  <main>
    {gallery.map((album, aIdx) => (
      <section class="chapter" id={`album-${aIdx}`}>
        <!-- Chapter Header -->
        <div class="chapter-header">
          <div class="ch-title">
            <h2>{album.title}</h2>
            <div class="ch-meta">{album.createTime} &nbsp;/&nbsp; VOL.{aIdx + 1}</div>
          </div>
          <div class="ch-desc">{album.desc}</div>
        </div>

        <!-- Horizontal Scroll Stream -->
        <div class="stream" id={`track-${aIdx}`}>
          <!-- Cover Card -->
          <div class="card is-cover" onclick={`openLightbox(${aIdx}, -1)`}>
            <div class="card-img-box">
              <div class="cover-badge">COVER</div>
              <img src={album.coverThumb} loading="lazy" alt="Cover" />
            </div>
            <div class="caption">The Cover</div>
          </div>

          <!-- Photo Cards -->
          {album.photos.map((photo, pIdx) => (
            <div class="card" onclick={`openLightbox(${aIdx}, ${pIdx})`}>
              <div class="card-img-box">
                <img src={photo.thumb} loading="lazy" alt={photo.title} />
              </div>
              <div class="caption">{photo.title}</div>
            </div>
          ))}
          <div style="flex:0 0 20px"></div>
        </div>
      </section>
    ))}
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="copyright">
        &copy; {new Date().getFullYear()} MYPIXELBOX. All Rights Reserved.
      </div>
      
      <div class="beian-group">
        <!-- ICP -->
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="beian-item">
          浙ICP备2025208482号-2
        </a>
        
        <span class="separator">|</span>

        <!-- 公网安备 -->
        <a href="https://beian.mps.gov.cn/#/query/webSearch?code=33010602014222" target="_blank" rel="noopener" class="beian-item">
          <img src="data:image/png;base64," alt="备案图标" class="police-icon">
          <span>浙公网安备 33010602014222号</span>
        </a>
      </div>
    </div>
  </footer>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox">
    <div class="lb-top-bar">
      <div class="lb-close" onclick="closeLightbox()">&times;</div>
    </div>

    <div class="lb-stage" id="lb-stage">
      <div class="spinner" id="lb-spinner"></div>
      <img id="lb-img" class="lb-img" src="" alt="Detail View" />
      
      <div class="lb-nav-zone lb-prev-zone" onclick="changePhoto(event, -1)">
        <div class="lb-arrow">&#8249;</div>
      </div>
      <div class="lb-nav-zone lb-next-zone" onclick="changePhoto(event, 1)">
        <div class="lb-arrow">&#8250;</div>
      </div>
    </div>

    <div class="lb-bottom-bar">
      <div class="lb-counter" id="lb-counter"></div>
    </div>
  </div>

  <!-- Client Side Script -->
  <script is:inline define:vars={{ clientData: gallery }}>
    // --- Menu Control ---
    const menu = document.getElementById('index-overlay');
    window.toggleMenu = function() {
      menu.classList.toggle('active');
      document.body.style.overflow = menu.classList.contains('active') ? 'hidden' : '';
    };

    window.scrollToAlbum = function(idx) {
      toggleMenu();
      const el = document.getElementById(`album-${idx}`);
      if(el) {
        const y = el.getBoundingClientRect().top + window.pageYOffset - 100;
        window.scrollTo({top: y, behavior: 'smooth'});
      }
    };

    // --- Intersection Observer (Fade in) ---
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('.chapter').forEach(el => observer.observe(el));

    // --- Horizontal Wheel Scroll ---
    document.querySelectorAll('.stream').forEach(track => {
      track.addEventListener('wheel', e => {
        if(e.deltaY !== 0) { e.preventDefault(); track.scrollLeft += e.deltaY; }
      }, { passive: false });
    });

    // --- Lightbox Logic ---
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lb-img');
    const lbSpinner = document.getElementById('lb-spinner');
    const lbCounter = document.getElementById('lb-counter');
    const albums = clientData;

    let currentAIdx = 0;
    let currentPIdx = 0;

    window.openLightbox = function(aIdx, pIdx) {
      currentAIdx = aIdx;
      currentPIdx = pIdx;
      updateLbImage(false);
      lb.style.display = 'flex';
      // Force Reflow
      lb.offsetHeight;
      lb.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    window.closeLightbox = function() {
      lb.classList.remove('active');
      setTimeout(() => {
        lb.style.display = 'none';
        lbImg.src = '';
        document.body.style.overflow = '';
      }, 300);
    };

    window.changePhoto = function(e, dir) {
      if(e) e.stopPropagation();
      const photosCount = albums[currentAIdx].photos.length;
      let next = currentPIdx + dir;
      
      // Wrap around logic including cover (index -1)
      if (next < -1) next = photosCount - 1; 
      if (next >= photosCount) next = -1;
      
      currentPIdx = next;
      updateLbImage(true);
    };

    function updateLbImage(animate) {
      const album = albums[currentAIdx];
      let src = "";
      let label = "";

      if (currentPIdx === -1) {
        src = album.coverFull;
        label = "COVER";
      } else {
        const photo = album.photos[currentPIdx];
        src = photo.full;
        label = `${currentPIdx + 1} / ${album.photos.length}`;
      }

      lbCounter.innerText = label;
      
      if(animate) {
        lbImg.classList.remove('show');
        lbSpinner.style.display = 'block';
      }

      const temp = new Image();
      temp.src = src;
      temp.onload = () => {
        lbImg.src = src;
        lbSpinner.style.display = 'none';
        lbImg.classList.add('show');
      };
    }

    // --- Swipe & Keyboard Navigation ---
    let touchStartX = 0;
    let touchStartY = 0;
    const stage = document.getElementById('lightbox');

    stage.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, {passive: true});

    stage.addEventListener('touchend', e => {
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      if (Math.abs(diffX) > Math.abs(diffY)) {
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) changePhoto(null, 1); // Swipe Left -> Next
          else changePhoto(null, -1);          // Swipe Right -> Prev
        }
      } else {
        if (Math.abs(diffY) > 60) closeLightbox(); // Swipe Up/Down -> Close
      }
    }, {passive: true});

    document.addEventListener('keydown', e => {
      if(!lb.classList.contains('active')) return;
      if(e.key === 'Escape') closeLightbox();
      if(e.key === 'ArrowRight') changePhoto(null, 1);
      if(e.key === 'ArrowLeft') changePhoto(null, -1);
    });
  </script>
</body>
</html>