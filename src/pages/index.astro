---
import axios from "axios";

// ----------------------------------------------------------------------
// 1. 工具函数
// ----------------------------------------------------------------------
function getImg(path: string, w: number = 0, q: number = 85) {
  if (!path) return "";
  if (path.startsWith("http")) return path;
  const cleanPath = path.replace(/^\//, "");
  const imageUrl = import.meta.env.IMAGE_URL;
  if (!imageUrl) return "";
  if (!w) return `${imageUrl}/${cleanPath}`;
  return `${imageUrl}/cdn-cgi/image/width=${w},quality=${q},format=auto/${cleanPath}`;
}

// ----------------------------------------------------------------------
// 2. 数据获取
// ----------------------------------------------------------------------
interface Photo {
  fileID: string;
  description: string;
  width: number;
  height: number;
}

interface Album {
  id: string;
  photos: Photo[];
  name: string;
  description: string;
  coverPhotoUrl: string;
}

async function fetchAlbums(): Promise<Album[]> {
  try {
    const API_BASE_URL = import.meta.env.API_BASE_URL;
    if (!API_BASE_URL) return [];
    const response = await axios.get(`${API_BASE_URL}/api/albums/gallery/public`);
    if (response.data.code !== 0) throw new Error(response.data.message);

    return response.data.data.map((album: any) => ({
      ...album,
      photos: album.photos || [],
    }));
  } catch (err: any) {
    console.error("Data Fetch Error:", err.message);
    return [];
  }
}

const albums: Album[] = await fetchAlbums();
const pageTitle = "🎄 Merry Christmas Gallery";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    
    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mountains+of+Christmas:wght@400;700&family=Quicksand:wght@400;600&display=swap" rel="stylesheet">
  </head>
  
  <body>
    <!-- 背景雪花 -->
    <div id="snow-container"></div>
    
    <!-- 顶部灯串 -->
    <div class="light-rope"></div>

    <header class="hero-header">
        <h1 class="christmas-title">Merry Christmas</h1>
        <p class="christmas-subtitle">2025 SPECIAL MOMENTS</p>
    </header>

    <main class="gallery-wrapper">
        {albums.map((album, index) => (
            <article class="album-card">
                <!-- 专辑标题 -->
                <div class="album-header">
                    <h2 class="album-title">
                        <span class="decoration">❄</span> {album.name}
                    </h2>
                    {album.description && <p class="album-desc">{album.description}</p>}
                </div>

                <!-- 封面图：现在也有相框了 -->
                {album.coverPhotoUrl && (
                    <div class="cover-section">
                        <!-- 封面相框容器 -->
                        <div class="vintage-frame-large">
                            <!-- 核心：CSS 模拟的四个相片角 -->
                            <div class="corner top-left"></div>
                            <div class="corner top-right"></div>
                            <div class="corner bottom-left"></div>
                            <div class="corner bottom-right"></div>

                            <img 
                                src={getImg(album.coverPhotoUrl, 1200, 90)} 
                                alt={album.name}
                                class="framed-img"
                            />
                        </div>
                        <div class="ribbon"><span>COVER</span></div>
                    </div>
                )}

                <!-- 照片流 -->
                <div class="photo-grid">
                    {album.photos.map((photo) => {
                        const aspectRatio = photo.width && photo.height ? `${photo.width} / ${photo.height}` : 'auto';
                        return (
                            <div class="photo-item">
                                <div class="polaroid-frame">
                                    <img 
                                        src={getImg(photo.fileID, 1200, 85)}
                                        style={`aspect-ratio: ${aspectRatio}`}
                                        loading="lazy"
                                        alt="Christmas Memory"
                                        class="content-img"
                                    />
                                    {photo.description && (
                                        <div class="caption">
                                            {photo.description}
                                        </div>
                                    )}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </article>
        ))}

        <footer class="site-footer">
            <p>Made with ❤️ for the Holidays</p>
            <p style="font-size: 0.8em; opacity: 0.7;">浙ICP备2025208482号-2</p>
        </footer>
    </main>

    <script>
        function letItSnow() {
            const container = document.getElementById('snow-container');
            if(!container) return;
            const count = 50;
            for(let i=0; i<count; i++) {
                const flake = document.createElement('div');
                flake.className = 'snowflake';
                flake.innerHTML = '❄';
                flake.style.left = Math.random() * 100 + '%';
                flake.style.animationDuration = (Math.random() * 5 + 5) + 's';
                flake.style.opacity = (Math.random() * 0.7 + 0.3).toString();
                flake.style.fontSize = (Math.random() * 1.5 + 0.5) + 'em';
                flake.style.animationDelay = Math.random() * 5 + 's';
                container.appendChild(flake);
            }
        }
        letItSnow();
    </script>

    <style>
        :root {
            /* 圣诞配色 */
            --bg-gradient: linear-gradient(135deg, #1a472a 0%, #0d2b1a 100%);
            --card-bg: #fffbf0;      
            --xmas-red: #c0392b;     
            --xmas-gold: #f1c40f;    
            --text-dark: #2c3e50;
            
            --font-title: 'Mountains of Christmas', cursive;
            --font-body: 'Quicksand', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: var(--bg-gradient);
            color: var(--text-dark);
            font-family: var(--font-body);
            min-height: 100vh;
            overflow-x: hidden;
            padding-bottom: 50px;
        }

        /* --- 雪花 --- */
        #snow-container {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; z-index: 1;
        }
        .snowflake {
            position: absolute; top: -50px; color: rgba(255,255,255,0.8);
            animation: fall linear infinite;
        }
        @keyframes fall {
            to { transform: translateY(110vh) rotate(360deg); }
        }

        /* --- 顶部彩灯 --- */
        .light-rope {
            text-align: center; white-space: nowrap; overflow: hidden;
            position: absolute; z-index: 10; margin: -15px 0 0 0;
            padding: 0; width: 100%; height: 50px; border-bottom: 2px solid #222;
        }
        .light-rope::after {
            content: ''; display: block; width: 100%; height: 20px;
            box-shadow: 
                20px 15px 15px 2px #f00, 60px 15px 15px 2px #0f0, 
                100px 15px 15px 2px #ff0, 140px 15px 15px 2px #00f,
                180px 15px 15px 2px #f00, 220px 15px 15px 2px #0f0, 
                260px 15px 15px 2px #ff0, 300px 15px 15px 2px #00f,
                340px 15px 15px 2px #f00, 380px 15px 15px 2px #0f0, 
                420px 15px 15px 2px #ff0, 460px 15px 15px 2px #00f,
                500px 15px 15px 2px #f00, 540px 15px 15px 2px #0f0,
                580px 15px 15px 2px #ff0, 620px 15px 15px 2px #00f,
                660px 15px 15px 2px #f00, 700px 15px 15px 2px #0f0,
                740px 15px 15px 2px #ff0, 780px 15px 15px 2px #00f,
                820px 15px 15px 2px #f00, 860px 15px 15px 2px #0f0,
                900px 15px 15px 2px #ff0, 940px 15px 15px 2px #00f,
                980px 15px 15px 2px #f00, 1020px 15px 15px 2px #0f0,
                1060px 15px 15px 2px #ff0, 1100px 15px 15px 2px #00f,
                1140px 15px 15px 2px #f00, 1180px 15px 15px 2px #0f0,
                1220px 15px 15px 2px #ff0, 1260px 15px 15px 2px #00f;
            border-radius: 50%; animation: flash 2s infinite alternate;
        }
        @keyframes flash { from { opacity: 0.5; } to { opacity: 1; } }

        /* --- Header --- */
        .hero-header {
            text-align: center; padding: 100px 20px 60px; color: #fff;
            position: relative; z-index: 2;
        }
        .christmas-title {
            font-family: var(--font-title); font-size: 5rem;
            text-shadow: 0 4px 10px rgba(0,0,0,0.5);
            margin-bottom: 10px;
        }
        .christmas-subtitle {
            font-size: 1.2rem; letter-spacing: 0.3em; color: var(--xmas-gold); font-weight: 600;
        }

        /* --- 主内容区 --- */
        .gallery-wrapper {
            max-width: 1000px; margin: 0 auto; padding: 0 20px;
            position: relative; z-index: 5;
        }

        .album-card {
            background: var(--card-bg);
            border-radius: 12px; padding: 30px; margin-bottom: 80px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 0 10px rgba(255, 255, 255, 0.1);
            position: relative;
        }
        /* 顶部红白条纹 */
        .album-card::before {
            content: ''; position: absolute; top: 0; left: 20px; right: 20px; height: 6px;
            background: repeating-linear-gradient(45deg, var(--xmas-red), var(--xmas-red) 10px, #fff 10px, #fff 20px);
            border-radius: 0 0 4px 4px;
        }

        .album-header { text-align: center; margin-bottom: 40px; }
        .album-title {
            font-family: var(--font-title); font-size: 3rem; color: var(--xmas-red);
            margin-bottom: 10px;
        }
        .album-desc { font-style: italic; color: #666; font-size: 1.1em; }

        /* --- 封面图 (复古相册风格) --- */
        .cover-section {
            margin-bottom: 60px;
            display: flex; justify-content: center;
            position: relative;
        }
        
        .vintage-frame-large {
            background: #fff;
            padding: 20px; /* 白色边框厚度 */
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            transform: rotate(-1.5deg); /* 微微倾斜，显得更自然 */
            position: relative;
            width: 100%;
        }

        /* 相片角效果 (CSS Triangles) */
        .corner {
            position: absolute; width: 0; height: 0; z-index: 2;
            border-style: solid;
        }
        /* 左上角 */
        .corner.top-left {
            top: 15px; left: 15px;
            border-width: 20px 20px 0 0;
            border-color: var(--text-dark) transparent transparent transparent;
        }
        /* 右上角 */
        .corner.top-right {
            top: 15px; right: 15px;
            border-width: 0 20px 20px 0;
            border-color: transparent var(--text-dark) transparent transparent;
        }
        /* 左下角 */
        .corner.bottom-left {
            bottom: 15px; left: 15px;
            border-width: 20px 0 0 20px;
            border-color: transparent transparent transparent var(--text-dark);
        }
        /* 右下角 */
        .corner.bottom-right {
            bottom: 15px; right: 15px;
            border-width: 0 0 20px 20px;
            border-color: transparent transparent var(--text-dark) transparent;
        }

        .framed-img {
            display: block; width: 100%; height: auto;
            border: 1px solid #ddd; /* 图片本身的细边框 */
        }

        .ribbon {
            position: absolute; right: -8px; top: -8px; z-index: 3;
            width: 85px; height: 85px; overflow: hidden;
        }
        .ribbon span {
            position: absolute; display: block; width: 120px; padding: 5px 0;
            background-color: var(--xmas-red); box-shadow: 0 5px 10px rgba(0,0,0,0.3);
            color: #fff; font-family: var(--font-body); font-weight: bold;
            font-size: 10px; text-align: center; text-transform: uppercase;
            left: -8px; top: 22px; transform: rotate(45deg);
        }

        /* --- 内页照片 (拍立得风格) --- */
        .photo-grid { display: flex; flex-direction: column; gap: 40px; }
        .photo-item { width: 100%; display: flex; justify-content: center; }
        .polaroid-frame {
            background: #fff;
            padding: 12px 12px 45px 12px; /* 底部留白写字 */
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            transition: transform 0.3s;
            max-width: 100%;
        }
        .photo-item:nth-child(odd) .polaroid-frame { transform: rotate(1deg); }
        .photo-item:nth-child(even) .polaroid-frame { transform: rotate(-1deg); }
        
        .polaroid-frame:hover {
            transform: rotate(0deg) scale(1.02) !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            z-index: 5;
        }

        .content-img {
            display: block; width: 100%; height: auto;
            max-height: 85vh; object-fit: contain; background: #eee;
        }
        
        .caption {
            font-family: var(--font-title); font-size: 1.4rem; color: #444;
            margin-top: 15px; text-align: center;
        }

        .site-footer {
            text-align: center; color: rgba(255,255,255,0.8);
            margin-top: 50px; font-family: var(--font-body);
        }

        @media (max-width: 768px) {
            .christmas-title { font-size: 3.5rem; }
            .album-card { padding: 15px; }
            .vintage-frame-large { padding: 10px; transform: rotate(0deg); }
            /* 手机端相片角稍微小一点 */
            .corner { border-width: 12px !important; } 
            .corner.top-left { border-width: 12px 12px 0 0 !important; }
            .corner.top-right { border-width: 0 12px 12px 0 !important; }
            .corner.bottom-left { border-width: 12px 0 0 12px !important; }
            .corner.bottom-right { border-width: 0 0 12px 12px !important; }
        }
    </style>
  </body>
</html>