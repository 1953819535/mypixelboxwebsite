---
import axios from "axios";

// ----------------------------------------------------------------------
// 1. 工具函数
// ----------------------------------------------------------------------
function getImg(path: string, w: number = 0, q: number = 80) {
  if (!path) return "";
  if (path.startsWith("http")) return path;
  const cleanPath = path.replace(/^\//, "");
  const imageUrl = import.meta.env.IMAGE_URL;
  if (!imageUrl) return "";
  if (!w) return `${imageUrl}/${cleanPath}`;
  return `${imageUrl}/cdn-cgi/image/width=${w},quality=${q},format=auto/${cleanPath}`;
}

// ----------------------------------------------------------------------
// 2. 数据获取与类型
// ----------------------------------------------------------------------
interface Photo {
  _id: string;
  albumId: string;
  fileID: string;
  description: string;
  order: number;
  width: number;
  height: number;
  isFeatured: boolean;
}

interface Album {
  id: string;
  photos: Photo[];
  name: string;
  description: string;
  coverPhotoUrl: string;
  order: number;
}

async function fetchAlbums(): Promise<Album[]> {
  try {
    const API_BASE_URL = import.meta.env.API_BASE_URL;
    if (!API_BASE_URL) return [];
    const response = await axios.get(
      `${API_BASE_URL}/api/albums/gallery/public`
    );
    if (response.data.code !== 0) throw new Error(response.data.message);

    return response.data.data.map((album: any) => ({
      ...album,
      photos: album.photos || [],
    }));
  } catch (err: any) {
    console.error("Data Fetch Error:", err.message);
    return [];
  }
}

const albums: Album[] = await fetchAlbums();
const pageTitle = "WANDER | Some Portfolio";
const isTestMode = import.meta.env.TEST_MODE === "true";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <title>{pageTitle}</title>
    {isTestMode && <meta name="test-mode" content="enabled" />}
    <!-- 引入艺术字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;0,700;1,400&family=Montserrat:wght@200;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- 氛围背景层 -->
    <div class="ambient-layer">
      <div class="noise-overlay"></div>
      <div class="snow-wrapper">
        <div class="snow-layer layer-1"></div>
        <div class="snow-layer layer-2"></div>
        <div class="snow-layer layer-3"></div>
      </div>
      <div class="vignette"></div>
    </div>

    <!-- 导航按钮 (极简风格) -->
    <button id="menu-btn" class="nav-btn">
      <span class="nav-text">MENU</span>
      <div class="nav-line"></div>
    </button>

    <!-- 菜单遮罩 -->
    <div id="menu-overlay" class="menu-overlay">
      <!-- 新增滚动视口容器 -->
      <div class="menu-scroll-view">
        <div class="menu-content">
          <div class="menu-decorative-line"></div>
          <p class="menu-label">THE COLLECTION</p>
          <ul class="menu-list">
            <li>
              <button data-goto="intro" class="menu-link home-link">
                <span class="link-text">Introduction</span>
              </button>
            </li>
            {
              albums.map((album, index) => (
                <li>
                  <button data-goto={`album-${album.id}`} class="menu-link">
                    <span class="menu-num">No.{index + 1}</span>
                    <span class="link-text">{album.name}</span>
                  </button>
                </li>
              ))
            }
          </ul>
          <button id="close-menu" class="close-btn-text">CLOSE</button>
        </div>
      </div>
    </div>

    <!-- 主内容区 -->
    <main class="snap-container">
      <!-- Intro Section -->
      <section id="intro" class="snap-section intro-section">
        <div class="intro-frame">
          <div class="decorative-star">✦</div>
          <h1 class="main-title">Wander</h1>
          <p class="sub-title">Winter Portfolio Log</p>
          <div class="intro-divider"></div>
          <p class="intro-date">DECEMBER 2025</p>
          {isTestMode && <div class="test-badge">Debug Mode</div>}
        </div>
        <div class="scroll-indicator">
          <span class="scroll-text">SCROLL</span>
          <div class="scroll-line"></div>
        </div>
      </section>

      {
        albums.map((album, index) => (
          <>
            {/* Album Cover Section */}
            {album.coverPhotoUrl && (
              <section
                id={`album-${album.id}`}
                class="snap-section album-cover"
              >
                <div class="glass-panel">
                  <span class="chapter-tag">Collection 0{index + 1}</span>
                  <h2 class="album-title">{album.name}</h2>
                  <div class="gold-divider" />
                  {album.description && (
                    <p class="album-desc">{album.description}</p>
                  )}
                </div>
                <div class="album-bg-img">
                  <img
                    src={getImg(album.coverPhotoUrl, 1600)}
                    alt={album.name}
                    loading="lazy"
                  />
                </div>
              </section>
            )}

            {/* Photos Section */}
            {album.photos.map((photo) => {
              const isPortrait = photo.height > photo.width;
              return (
                <section
                  class={`snap-section photo-frame ${isPortrait ? "frame-portrait" : "frame-landscape"}`}
                >
                  <div class="art-mat">
                    <div class="image-wrapper">
                      <img
                        src={getImg(photo.fileID, 1600)}
                        loading="lazy"
                        alt={photo.description}
                      />
                      {/* 图片上的装饰角标 */}
                      <div class="corner-decor top-left" />
                      <div class="corner-decor bottom-right" />
                    </div>
                  </div>

                  <div class="caption-card">
                    <div class="caption-content">
                      <div class="caption-header">
                        <span class="caption-album">{album.name}</span>
                        <span class="caption-meta">
                          {photo.width} × {photo.height}
                        </span>
                      </div>
                      {photo.description && (
                        <p class="caption-text">{photo.description}</p>
                      )}
                    </div>
                  </div>
                </section>
              );
            })}
          </>
        ))
      }

      <section class="snap-section footer-section">
        <div class="footer-content">
          <div class="decorative-star">✦</div>
          <p>Merry Christmas & Happy New Year</p>
          <div class="footer-line"></div>
          <div class="footer-beian">
            <a
              href="https://beian.miit.gov.cn/"
              target="_blank"
              rel="noopener noreferrer"
              class="beian-link">浙ICP备2025208482号-2</a
            >
          </div>
        </div>
      </section>
    </main>

    <script>
      const menuBtn = document.getElementById("menu-btn");
      const overlay = document.getElementById("menu-overlay");
      const closeMenuBtn = document.getElementById("close-menu");
      const menuLinks = document.querySelectorAll(".menu-link");

      function toggleMenu() {
        overlay?.classList.toggle("active");
        menuBtn?.classList.toggle("hidden");
      }

      menuBtn?.addEventListener("click", toggleMenu);
      closeMenuBtn?.addEventListener("click", toggleMenu);

      menuLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          // @ts-ignore
          const targetId = e.currentTarget.dataset.goto;
          const targetElement = document.getElementById(targetId);
          if (targetElement) {
            overlay?.classList.remove("active");
            menuBtn?.classList.remove("hidden");
            targetElement.scrollIntoView({ behavior: "smooth" });
          }
        });
      });
    </script>

    <style>
      :root {
        /* 圣诞/冬日艺术调色盘 */
        --bg-deep: #091210; /* 深松林绿 */
        --bg-panel: rgba(14, 22, 19, 0.75);
        --text-gold: #d4af37; /* 香槟金 */
        --text-cream: #eaeaea; /* 米白 */
        --text-muted: #8f9e99; /* 灰绿 */
        --border-gold: rgba(212, 175, 55, 0.3);

        --font-serif: "Cormorant Garamond", serif;
        --font-sans: "Montserrat", sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: var(--bg-deep);
        color: var(--text-cream);
        font-family: var(--font-sans);
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* --- 氛围背景层 (Noise & Snow) --- */
      .ambient-layer {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
      }

      .noise-overlay {
        position: absolute;
        inset: 0;
        opacity: 0.04;
        background: url('data:image/svg+xml;utf8,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noise"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noise)" opacity="1"/%3E%3C/svg%3E');
      }

      .vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(
          circle,
          transparent 40%,
          rgba(0, 0, 0, 0.6) 100%
        );
      }

      /* CSS 飘雪动画 */
      .snow-wrapper {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      .snow-layer {
        position: absolute;
        top: -100vh;
        left: 0;
        right: 0;
        bottom: 0;
        background-image:
          radial-gradient(
            3px 3px at 20% 30%,
            rgba(255, 255, 255, 0.8) 50%,
            transparent
          ),
          radial-gradient(
            2px 2px at 40% 70%,
            rgba(255, 255, 255, 0.7) 50%,
            transparent
          ),
          radial-gradient(
            4px 4px at 50% 10%,
            rgba(255, 255, 255, 0.7) 50%,
            transparent
          ),
          radial-gradient(
            3px 3px at 80% 50%,
            rgba(255, 255, 255, 0.6) 50%,
            transparent
          );
        background-size: 200px 200px;
        animation: snowfall linear infinite;
      }
      .layer-1 {
        animation-duration: 15s;
        opacity: 0.4;
      }
      .layer-2 {
        animation-duration: 10s;
        background-size: 300px 300px;
        opacity: 0.3;
        animation-delay: -5s;
      }
      .layer-3 {
        animation-duration: 25s;
        background-size: 500px 500px;
        opacity: 0.1;
      }

      @keyframes snowfall {
        0% {
          transform: translateY(0);
        }
        100% {
          transform: translateY(100vh);
        }
      }

      /* --- 布局容器 --- */
      .snap-container {
        position: relative;
        z-index: 10;
        height: 100dvh;
        width: 100vw;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
      }
      .snap-container::-webkit-scrollbar {
        display: none;
      }

      .snap-section {
        height: 100dvh;
        width: 100vw;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        position: relative;
        overflow: hidden;
        display: flex;
      }

      /* --- 导航按钮 --- */
      .nav-btn {
        position: fixed;
        top: 30px;
        right: 30px;
        z-index: 100;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        background: transparent;
        border: none;
        cursor: pointer;
        opacity: 0.8;
        transition: opacity 0.3s;
      }
      .nav-btn:hover {
        opacity: 1;
      }
      .nav-btn.hidden {
        opacity: 0;
        pointer-events: none;
      }

      .nav-text {
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 0.2em;
        color: var(--text-gold);
      }
      .nav-line {
        width: 30px;
        height: 1px;
        background: var(--text-cream);
      }

      /* --- 菜单 --- */
      /* --- 菜单样式修正 (支持长列表滚动) --- */
      .menu-overlay {
        position: fixed;
        inset: 0;
        z-index: 95;
        background: rgba(
          9,
          18,
          16,
          0.98
        ); /* 稍微加深背景，防止文字重叠看不太清 */
        backdrop-filter: blur(15px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        /* 移除原本的 flex center，改为由内部容器控制布局 */
        display: block;
      }

      .menu-overlay.active {
        opacity: 1;
        pointer-events: auto;
      }

      /* 新增：滚动视口 */
      .menu-scroll-view {
        width: 100%;
        height: 100%;
        overflow-y: auto; /* 允许垂直滚动 */
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        /* 关键：使用 Flex 布局配合子元素的 margin: auto 实现智能居中 */

        /* 隐藏滚动条 (Chrome/Safari) */
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
      }

      .menu-scroll-view::-webkit-scrollbar {
        display: none;
      }

      /* 内容容器 */
      .menu-content {
        text-align: center;
        width: 100%;
        max-width: 500px;
        /* 关键：margin: auto 在 Flex 容器中可以实现垂直居中，
     当高度溢出时，它会自然转变为顶部对齐并允许滚动 */
        margin: auto;
        padding: 80px 20px; /* 增加上下留白，防止滚动到底部太贴边 */
        position: relative;
      }

      /* 以下保持原有设计风格不变 */
      .menu-decorative-line {
        width: 1px;
        height: 60px;
        background: linear-gradient(to bottom, transparent, var(--text-gold));
        margin: 0 auto 20px;
      }

      .menu-label {
        font-family: var(--font-sans);
        font-size: 11px;
        letter-spacing: 0.3em;
        color: var(--text-muted);
        margin-bottom: 40px;
      }

      .menu-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 24px; /* 稍微增加间距，方便点击 */
      }

      .menu-link {
        background: none;
        border: none;
        color: var(--text-cream);
        cursor: pointer;
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 300;
        font-style: italic;
        transition: all 0.3s ease;
        position: relative;
        padding: 5px 20px;
        line-height: 1.2;
      }

      .menu-link:hover {
        color: var(--text-gold);
        transform: scale(1.05);
      }

      .menu-num {
        display: block;
        font-family: var(--font-sans);
        font-size: 9px;
        font-style: normal;
        color: var(--text-muted);
        letter-spacing: 0.1em;
        margin-bottom: 2px;
      }

      .close-btn-text {
        margin-top: 60px;
        background: none;
        border: 1px solid var(--border-gold);
        color: var(--text-gold);
        padding: 12px 36px;
        font-size: 10px;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
      }

      .close-btn-text:hover {
        background: var(--text-gold);
        color: var(--bg-deep);
      }

      /* --- Intro Section --- */
      .intro-section {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
      }
      .intro-frame {
        border: 1px solid var(--border-gold);
        padding: 60px 40px;
        position: relative;
        max-width: 90vw;
      }
      .decorative-star {
        color: var(--text-gold);
        font-size: 20px;
        margin-bottom: 20px;
      }
      .main-title {
        font-family: var(--font-serif);
        font-size: clamp(3.5rem, 15vw, 8rem);
        font-weight: 400;
        color: var(--text-gold);
        line-height: 0.9;
        margin-bottom: 10px;
        text-shadow: 0 0 30px rgba(212, 175, 55, 0.2);
      }
      .sub-title {
        font-family: var(--font-sans);
        font-weight: 300;
        font-size: clamp(12px, 3vw, 16px);
        letter-spacing: 0.3em;
        text-transform: uppercase;
      }
      .intro-divider {
        width: 100%;
        max-width: 100px;
        height: 1px;
        background: var(--border-gold);
        margin: 30px auto;
      }
      .intro-date {
        font-family: var(--font-serif);
        font-style: italic;
        color: var(--text-muted);
      }
      .scroll-indicator {
        position: absolute;
        bottom: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        opacity: 0.5;
        animation: pulse 3s infinite;
      }
      .scroll-text {
        font-size: 9px;
        letter-spacing: 0.2em;
      }
      .scroll-line {
        width: 1px;
        height: 40px;
        background: var(--text-cream);
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 0.3;
        }
        50% {
          opacity: 0.8;
        }
      }

      /* --- Album Cover --- */
      .album-cover {
        position: relative;
        justify-content: center;
        align-items: center;
      }
      .album-bg-img {
        position: absolute;
        inset: 0;
        z-index: 1;
      }
      .album-bg-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6; /* 让背景暗一点 */
        filter: saturate(0.8) contrast(1.1);
        transition: transform 10s ease;
      }
      /* 缓慢缩放动效 */
      .album-cover:hover .album-bg-img img {
        transform: scale(1.05);
      }

      .glass-panel {
        position: relative;
        z-index: 2;
        background: rgba(18, 33, 29, 0.6); /* 毛玻璃深色底 */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 40px;
        max-width: 80vw;
        text-align: center;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
      }
      .chapter-tag {
        display: block;
        font-size: 10px;
        letter-spacing: 0.2em;
        color: var(--text-gold);
        margin-bottom: 15px;
        text-transform: uppercase;
      }
      .album-title {
        font-family: var(--font-serif);
        font-size: clamp(2.5rem, 8vw, 4rem);
        font-style: italic;
        line-height: 1.1;
        margin-bottom: 20px;
      }
      .gold-divider {
        width: 40px;
        height: 2px;
        background: var(--text-gold);
        margin: 0 auto 20px;
      }
      .album-desc {
        font-size: 14px;
        line-height: 1.6;
        color: #d1d1d1;
        font-family: var(--font-serif);
      }

      /* --- Photo Frame Logic --- */
      .photo-frame {
        flex-direction: column;
        background: var(--bg-deep);
      }

      .art-mat {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        position: relative;
      }

      .image-wrapper {
        position: relative;
        max-width: 100%;
        max-height: 100%;
        /* 关键：给图片增加阴影和边框，像画廊里的画 */
        box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.8);
      }

      .image-wrapper img {
        display: block;
        max-width: 100%;
        max-height: calc(100dvh - 160px); /* 留出底部空间 */
        width: auto;
        height: auto;
        object-fit: contain;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }

      /* 金色边角装饰 */
      .corner-decor {
        position: absolute;
        width: 20px;
        height: 20px;
        border-color: var(--text-gold);
        border-style: solid;
        opacity: 0.6;
      }
      .top-left {
        top: -10px;
        left: -10px;
        border-width: 1px 0 0 1px;
      }
      .bottom-right {
        bottom: -10px;
        right: -10px;
        border-width: 0 1px 1px 0;
      }

      .caption-card {
        flex: none;
        width: 100%;
        padding: 0 20px 40px;
        z-index: 20;
      }
      .caption-content {
        background: var(--bg-panel);
        backdrop-filter: blur(8px);
        padding: 20px;
        border-top: 1px solid var(--border-gold);
      }
      .caption-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding-bottom: 8px;
      }
      .caption-album {
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 0.15em;
        color: var(--text-gold);
        text-transform: uppercase;
      }
      .caption-meta {
        font-family: monospace;
        font-size: 10px;
        color: var(--text-muted);
      }
      .caption-text {
        font-family: var(--font-serif);
        font-size: 16px;
        color: var(--text-cream);
        line-height: 1.4;
      }

      /* PC Layout Optimization */
      @media (min-width: 768px) {
        .intro-frame {
          padding: 80px 100px;
        }

        /* Cover 左右布局 */
        .album-cover {
          flex-direction: row;
        }
        .album-bg-img {
          width: 50%; /* 只有一半是图片，另一半留白 */
          left: 50%;
          opacity: 0.8;
          mask-image: linear-gradient(to right, transparent, black 20%);
          -webkit-mask-image: linear-gradient(to right, transparent, black 20%);
        }
        .glass-panel {
          margin-left: -10vw; /* 稍微重叠 */
          text-align: left;
          padding: 60px;
          min-width: 400px;
        }
        .gold-divider {
          margin: 0 0 20px 0;
        }
        .album-title {
          font-size: 5rem;
        }

        /* Photo Frame 左右布局 (画廊模式) */
        .frame-portrait {
          flex-direction: row;
        }
        .frame-portrait .art-mat {
          padding: 60px;
          background: linear-gradient(90deg, var(--bg-deep) 0%, #0d1a16 100%);
        }
        .frame-portrait .caption-card {
          width: 350px;
          height: 100%;
          padding: 0;
          display: flex;
          align-items: center;
          border-left: 1px solid rgba(255, 255, 255, 0.05);
          background: var(--bg-deep);
        }
        .frame-portrait .caption-content {
          background: transparent;
          backdrop-filter: none;
          border-top: none;
          padding: 40px;
          width: 100%;
        }

        /* 横构图 PC 优化 */
        .frame-landscape {
          justify-content: center;
          align-items: center;
        }
        .frame-landscape .art-mat {
          width: 100%;
          height: 100%;
          padding-bottom: 120px; /* 给下方文字留位置 */
        }
        .frame-landscape .caption-card {
          position: absolute;
          bottom: 40px;
          left: 50%;
          transform: translateX(-50%);
          width: auto;
          min-width: 400px;
          padding: 0;
        }
        .frame-landscape .caption-content {
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-top: 1px solid var(--border-gold);
        }
      }

      /* Footer */
      /* --- Footer 修正 --- */
      .footer-section {
        /* 确保继承 snap-section 的 flex 属性，并添加居中规则 */
        display: flex;
        justify-content: center; /* 水平居中 */
        align-items: center; /* 垂直居中 */
        flex-direction: column; /* 确保主轴方向一致，虽然只有一个子元素 */

        background-color: var(--bg-deep);
        color: var(--text-muted);
        text-align: center;
        position: relative;
        z-index: 20; /* 确保在背景层之上 */
      }

      .footer-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
        width: 100%;
        max-width: 600px; /* 限制宽度，防止在大屏上太散 */
        padding: 0 20px; /* 防止在小屏上贴边 */
      }

      /* 之前定义的内部元素样式保持不变 */
      .footer-line {
        width: 1px;
        height: 40px; /* 稍微拉长一点线条，更优雅 */
        background: linear-gradient(to bottom, var(--text-muted), transparent);
        opacity: 0.5;
      }

      .decorative-star {
        color: var(--text-gold);
        font-size: 18px;
        animation: twinkle 3s infinite ease-in-out;
      }

      @keyframes twinkle {
        0%,
        100% {
          opacity: 0.4;
          transform: scale(0.8);
        }
        50% {
          opacity: 1;
          transform: scale(1.2);
        }
      }

      .beian-link {
        color: var(--text-muted);
        text-decoration: none;
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 0.2em;
        opacity: 0.6;
        transition: all 0.3s;
        border-bottom: 1px solid transparent;
      }

      .beian-link:hover {
        color: var(--text-gold);
        opacity: 1;
        border-bottom-color: var(--text-gold);
      }
    </style>
  </body>
</html>
