---
import axios from "axios";

// ----------------------------------------------------------------------
// 工具与数据
// ----------------------------------------------------------------------
function getImg(path: string, w: number = 0, q: number = 80) {
  if (!path) return "";
  if (path.startsWith("http")) return path;
  const cleanPath = path.replace(/^\//, "");
  const imageUrl = import.meta.env.IMAGE_URL;
  if (!imageUrl) return "";
  if (!w) return `${imageUrl}/${cleanPath}`;
  return `${imageUrl}/cdn-cgi/image/width=${w},quality=${q},format=auto/${cleanPath}`;
}

interface Photo { fileID: string; description: string; width: number; height: number; }
interface Album { id: string; photos: Photo[]; name: string; description: string; coverPhotoUrl: string; }

async function fetchAlbums(): Promise<Album[]> {
  try {
    const API_BASE_URL = import.meta.env.API_BASE_URL;
    if (!API_BASE_URL) return [];
    const response = await axios.get(`${API_BASE_URL}/api/albums/gallery/public`);
    if (response.data.code !== 0) throw new Error(response.data.message);
    return response.data.data.map((album: any) => ({ ...album, photos: album.photos || [] }));
  } catch (err: any) { return []; }
}

const albums: Album[] = await fetchAlbums();
const pageTitle = "ARCHIVE . 2025";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <!-- 字体：Cinzel (装饰), Lato (正文), Space Mono (数据) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Space+Mono:ital@0;1&display=swap" rel="stylesheet">
  </head>
  
  <body>
    <!-- 背景纹理 -->
    <div class="bg-texture"></div>

    <!-- 
      === 新增：移动端/全局顶部导航栏 (Sticky) ===
      包含 Logo 和 菜单触发按钮 
    -->
    <nav class="navbar-fixed" id="navbar">
        <div class="nav-brand">MOMENTS.</div>
        <button class="menu-trigger" id="menu-btn" aria-label="Menu">
            <span class="menu-text">MENU</span>
            <div class="hamburger">
                <span></span>
                <span></span>
            </div>
        </button>
    </nav>

    <!-- 
      === 新增：全屏导航菜单 (Overlay) ===
    -->
    <div class="fullscreen-menu" id="fs-menu">
        <div class="menu-inner">
            <h3 class="menu-header">INDEX</h3>
            <ul class="menu-list">
                {albums.map((album, idx) => (
                    <li>
                        <a href={`#album-${idx}`} class="menu-link" data-close-menu>
                            <span class="idx">0{idx + 1}</span>
                            <span class="label">{album.name}</span>
                        </a>
                    </li>
                ))}
            </ul>
            <div class="menu-footer">
                <p>2025 VISUAL ARCHIVE</p>
            </div>
        </div>
    </div>

    <!-- 顶部 Hero 区域 -->
    <header class="archive-header">
        <div class="header-inner">
            <div class="top-bar">
                <span class="mono-tag">EST. 2025</span>
            </div>
            <h1 class="main-title">MOMENTS</h1>
            <p class="sub-title">Collection of Time & Light</p>
            <div class="scroll-line"></div>
        </div>
    </header>

    <main class="content-wrapper">
        {albums.map((album, idx) => (
            <article class="album-container" id={`album-${idx}`}>
                
                <!-- 左侧信息区 (Sticky on Desktop) -->
                <aside class="album-info-col">
                    <div class="sticky-wrapper">
                        <div class="album-meta">
                            <span class="album-id">NO. {String(idx + 1).padStart(2, '0')}</span>
                            <span class="album-year">2025 REC</span>
                        </div>
                        <h2 class="album-name">{album.name}</h2>
                        <div class="separator-line"></div>
                        {album.description && <p class="album-desc">{album.description}</p>}
                        
                        <div class="tech-stats">
                            <div><span>items</span> {album.photos.length}</div>
                        </div>
                    </div>
                </aside>

                <!-- 右侧图片画廊 -->
                <div class="album-gallery-col">
                    {/* 封面 */}
                    {album.coverPhotoUrl && (
                        <div class="gallery-item cover-item">
                            <div class="img-frame">
                                <img 
                                    src={getImg(album.coverPhotoUrl, 1600, 90)} 
                                    alt={album.name}
                                    class="photo-img"
                                />
                                <div class="overlay-badge">COVER</div>
                            </div>
                        </div>
                    )}

                    {/* 瀑布流/卡片流 */}
                    <div class="masonry-grid">
                        {album.photos.map((photo) => (
                            <div class="gallery-item">
                                <div class="img-frame">
                                    <img 
                                        src={getImg(photo.fileID, 1000, 85)}
                                        loading="lazy"
                                        alt="Archive Memory"
                                        class="photo-img"
                                    />
                                    {photo.description && (
                                        <div class="img-caption-glass">
                                            <p>{photo.description}</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </article>
        ))}
    </main>

    <footer class="archive-footer">
        <div class="footer-inner">
            <p>END OF ARCHIVE</p>
            <p class="copyright">DESIGNED FOR MEMORIES &copy; 2025</p>
        </div>
    </footer>

    <!-- 交互脚本 -->
    <script>
        const menuBtn = document.getElementById('menu-btn');
        const fsMenu = document.getElementById('fs-menu');
        const navbar = document.getElementById('navbar');
        const menuLinks = document.querySelectorAll('[data-close-menu]');

        // 1. 菜单切换
        if(menuBtn && fsMenu) {
            menuBtn.addEventListener('click', () => {
                const isOpen = fsMenu.classList.contains('active');
                if(isOpen) {
                    fsMenu.classList.remove('active');
                    menuBtn.classList.remove('active');
                    document.body.style.overflow = ''; // 恢复滚动
                } else {
                    fsMenu.classList.add('active');
                    menuBtn.classList.add('active');
                    document.body.style.overflow = 'hidden'; // 禁止背景滚动
                }
            });
        }

        // 2. 点击链接自动关闭菜单
        menuLinks.forEach(link => {
            link.addEventListener('click', () => {
                fsMenu?.classList.remove('active');
                menuBtn?.classList.remove('active');
                document.body.style.overflow = '';
            });
        });

        // 3. 滚动监听：导航栏磨砂效果 + 隐藏/显示
        let lastScrollY = window.scrollY;
        window.addEventListener('scroll', () => {
            if(!navbar) return;
            
            // 滚动超过50px才显示背景
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>

    <style>
        :root {
            --bg-root: #0b0b0b;
            --text-primary: #e5e5e5;
            --text-secondary: #888888;
            --accent-gold: #c5a47e;
            --border-color: rgba(255, 255, 255, 0.1);
            
            --font-display: 'Cinzel', serif;
            --font-body: 'Lato', sans-serif;
            --font-mono: 'Space Mono', monospace;
            
            --nav-height: 70px;
            --container-width: 1400px;
        }

        html { scroll-behavior: smooth; }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-root);
            color: var(--text-primary);
            font-family: var(--font-body);
            overflow-x: hidden;
            line-height: 1.6;
        }

        .bg-texture {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' opacity='0.03' filter='url(%23noise)'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 0;
        }

        /* 
           === NAVIGATION STYLES === 
           Designed for High-End App Feel
        */
        .navbar-fixed {
            position: fixed; top: 0; left: 0; width: 100%; height: var(--nav-height);
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 30px; z-index: 100;
            transition: background 0.3s ease, backdrop-filter 0.3s ease;
        }
        /* 滚动后变深并加模糊 */
        .navbar-fixed.scrolled {
            background: rgba(11, 11, 11, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-brand {
            font-family: var(--font-display); font-size: 1.2rem; font-weight: 600;
            letter-spacing: 0.1em; color: #fff;
        }

        .menu-trigger {
            background: none; border: none; cursor: pointer;
            display: flex; align-items: center; gap: 10px;
            color: var(--accent-gold);
            z-index: 101; /* Above fullscreen menu */
        }
        .menu-text {
            font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em;
        }
        .hamburger {
            width: 30px; height: 12px;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .hamburger span {
            display: block; width: 100%; height: 1px; background: currentColor;
            transition: transform 0.3s, opacity 0.3s;
        }
        /* Menu Open State Animation */
        .menu-trigger.active .menu-text { display: none; }
        .menu-trigger.active .hamburger span:first-child { transform: translateY(5px) rotate(45deg); }
        .menu-trigger.active .hamburger span:last-child { transform: translateY(-6px) rotate(-45deg); }

        /* Fullscreen Menu Overlay */
        .fullscreen-menu {
            position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
            background: #0f0f0f;
            z-index: 99;
            opacity: 0; pointer-events: none;
            transition: opacity 0.4s ease;
            display: flex; align-items: center; justify-content: center;
        }
        .fullscreen-menu.active { opacity: 1; pointer-events: auto; }
        
        .menu-inner { text-align: center; max-width: 600px; width: 100%; padding: 20px; }
        .menu-header {
            font-family: var(--font-mono); font-size: 0.8rem; color: #555;
            letter-spacing: 0.3em; margin-bottom: 40px; border-bottom: 1px solid #333;
            display: inline-block; padding-bottom: 5px;
        }
        .menu-list { list-style: none; }
        .menu-list li { margin-bottom: 25px; opacity: 0; transform: translateY(20px); transition: 0.4s; }
        /* Staggered animation for list items */
        .fullscreen-menu.active .menu-list li { opacity: 1; transform: translateY(0); }
        .fullscreen-menu.active .menu-list li:nth-child(1) { transition-delay: 0.1s; }
        .fullscreen-menu.active .menu-list li:nth-child(2) { transition-delay: 0.2s; }
        .fullscreen-menu.active .menu-list li:nth-child(3) { transition-delay: 0.3s; }
        .fullscreen-menu.active .menu-list li:nth-child(4) { transition-delay: 0.4s; }

        .menu-link {
            text-decoration: none; color: #fff; display: flex; align-items: center; justify-content: center; gap: 15px;
            font-family: var(--font-display); font-size: 2rem;
            transition: color 0.3s;
        }
        .menu-link:hover { color: var(--accent-gold); }
        .menu-link .idx { font-family: var(--font-mono); font-size: 0.8rem; color: #444; margin-top: 5px; }

        .menu-footer {
            margin-top: 60px; font-family: var(--font-mono); font-size: 0.7rem; color: #444;
        }

        /* --- Hero Section --- */
        .archive-header {
            height: 90vh;
            display: flex; align-items: center; justify-content: center;
            text-align: center; position: relative;
            background: radial-gradient(circle at center, #1a1a1a 0%, var(--bg-root) 70%);
            padding-top: var(--nav-height); /* Prevent overlap */
        }
        .top-bar { display: flex; justify-content: center; gap: 20px; margin-bottom: 20px; }
        .mono-tag { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-gold); border: 1px solid rgba(197, 164, 126, 0.3); padding: 4px 8px; border-radius: 2px; }
        .main-title { font-family: var(--font-display); font-size: clamp(3rem, 10vw, 6rem); letter-spacing: 0.1em; margin-bottom: 20px; text-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .sub-title { font-size: 1.1rem; color: var(--text-secondary); letter-spacing: 0.2em; font-weight: 300; text-transform: uppercase; }
        .scroll-line { width: 1px; height: 80px; background: linear-gradient(to bottom, var(--accent-gold), transparent); position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); }

        /* --- Content Layout --- */
        .content-wrapper { max-width: var(--container-width); margin: 0 auto; padding: 0 40px; position: relative; z-index: 2; }
        
        .album-container {
            display: grid;
            grid-template-columns: 350px 1fr; 
            gap: 60px;
            margin-bottom: 150px;
            /* 用于锚点定位时的偏移，避免被navbar遮挡 */
            scroll-margin-top: 100px; 
            border-top: 1px solid var(--border-color);
            padding-top: 60px;
        }

        .sticky-wrapper { position: sticky; top: 100px; padding-right: 20px; }
        .album-meta { display: flex; justify-content: space-between; font-family: var(--font-mono); color: var(--text-secondary); font-size: 0.8rem; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; }
        .album-name { font-family: var(--font-display); font-size: 2.5rem; line-height: 1.2; margin-bottom: 20px; color: #fff; }
        .separator-line { width: 40px; height: 2px; background: var(--accent-gold); margin-bottom: 25px; }
        .album-desc { font-size: 1rem; color: #aaa; margin-bottom: 40px; font-weight: 300; text-align: justify; }
        .tech-stats { font-family: var(--font-mono); font-size: 0.7rem; color: #555; }
        .tech-stats span { color: #888; margin-right: 5px; text-transform: uppercase; }

        .masonry-grid { column-count: 2; column-gap: 30px; }
        .gallery-item { break-inside: avoid; margin-bottom: 30px; position: relative; }
        .img-frame {
            position: relative; overflow: hidden; background: #111;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }
        .img-frame:hover { transform: translateY(-5px); box-shadow: 0 20px 50px rgba(0,0,0,0.7); }
        .photo-img { display: block; width: 100%; height: auto; filter: brightness(0.9) contrast(1.05); transition: filter 0.4s ease, transform 0.6s ease; }
        .img-frame:hover .photo-img { filter: brightness(1.05) contrast(1.05); transform: scale(1.03); }
        
        .overlay-badge {
            position: absolute; top: 15px; left: 15px; background: rgba(255,255,255,0.9); color: #000;
            padding: 4px 10px; font-family: var(--font-mono); font-size: 0.6rem; font-weight: bold; letter-spacing: 0.1em; pointer-events: none;
        }
        .img-caption-glass {
            position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(8px);
            padding: 15px; border-top: 1px solid rgba(255,255,255,0.1);
            transform: translateY(100%); transition: transform 0.3s ease;
        }
        .img-frame:hover .img-caption-glass { transform: translateY(0); }
        .img-caption-glass p { font-size: 0.85rem; color: #ddd; font-weight: 300; text-align: center; }

        .archive-footer { padding: 80px 0; border-top: 1px solid var(--border-color); text-align: center; }
        .archive-footer p { font-family: var(--font-mono); font-size: 0.7rem; color: #444; letter-spacing: 0.2em; margin-bottom: 10px; }

        /* ------------------------------------------------------------------ */
        /* MOBILE OPTIMIZATION (Max-width: 900px)                             */
        /* ------------------------------------------------------------------ */
        @media (max-width: 900px) {
            .navbar-fixed { padding: 0 20px; }
            .archive-header { height: 70vh; }
            .content-wrapper { padding: 0 20px; }
            
            .album-container {
                display: flex; flex-direction: column; gap: 40px;
                padding-top: 40px; margin-bottom: 100px;
                scroll-margin-top: 80px;
            }

            /* 左侧信息栏优化 */
            .album-info-col { width: 100%; margin-bottom: 0; }
            .sticky-wrapper { position: static; }
            .album-name { font-size: 2rem; margin-bottom: 15px; }
            .album-desc { font-size: 0.9rem; line-height: 1.5; color: #999; margin-bottom: 20px; }

            /* 图片流优化 */
            .masonry-grid { column-count: 1; }
            
            /* 移动端标题直接显示在下方，不再遮挡图片 */
            .img-caption-glass {
                position: relative; transform: none; background: transparent; backdrop-filter: none;
                padding: 12px 0 0 0; border-top: none; text-align: left;
            }
            .img-caption-glass p { color: #888; font-size: 0.8rem; text-align: left; }
            
            .img-frame { box-shadow: none; background: transparent; overflow: visible; }
            .photo-img { border-radius: 4px; }
            .cover-item .photo-img { border-radius: 4px; }

            /* 移动端菜单样式微调 */
            .menu-link { font-size: 1.5rem; }
        }
    </style>
  </body>
</html>